# ========================================================
# ENERGYA PHOTOBOOTH - ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in your secrets,
# or add these variables to your Vercel Project Settings.
# ========================================================

# Server Port (Default: 3000)
PORT=3000

# Cloudflare R2 Credentials
# Found in: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET=energya
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# Photobooth Operating Mode ('both', 'r2', or 'local')
STORAGE_MODE=both
COUNTDOWN_SECONDS=3
IDLE_TIMEOUT_SECONDS=45
PAPER_SIZE=4x6
PRINT_ENABLED=true
MIRROR_PHOTO=false

